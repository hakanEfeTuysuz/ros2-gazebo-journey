<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

    <!-- RViz2 için Renk Tanımları -->
    <material name="blue"><color rgba="0.1 0.2 0.8 1"/></material>
    <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>

    <!-- 1. KÖK NOKTA: base_footprint = tekerlek aksının orta noktasının yer izdüşümü -->
    <link name="base_footprint"/>

    <!-- base_link, aksın 0.15 m ÖNÜNDE ve 0.08 m yukarıda (aks yüksekliği = tekerlek yarıçapı 0.06) -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.15 0 0.08" rpy="0 0 0"/>
    </joint>

    <!-- 2. ANA GÖVDE (Şasi) -->
    <link name="base_link">
        <visual>
            <geometry><box size="0.5 0.3 0.1"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry><box size="0.5 0.3 0.1"/></geometry>
        </collision>
        <inertial>
            <mass value="2.0"/>
            <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.05"/>
        </inertial>
    </link>

    <!-- 3. TEKERLEK MAKROSU -->
    <xacro:macro name="drive_wheel" params="prefix y_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
                <geometry><cylinder radius="0.06" length="0.04"/></geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
                <geometry><cylinder radius="0.06" length="0.04"/></geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
                <mass value="0.3"/>
                <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
            </inertial>
        </link>

        <!-- base_link'e göre x=-0.15 => base_footprint'e göre x=0 (aks tam footprint üzerinde) -->
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="-0.15 ${y_reflect * 0.17} -0.02" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <gazebo reference="${prefix}_wheel">
            <material>Gazebo/Black</material>
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>1.0</maxVel>
        </gazebo>
    </xacro:macro>

    <xacro:drive_wheel prefix="left" y_reflect="1"/>
    <xacro:drive_wheel prefix="right" y_reflect="-1"/>

    <!-- 4. ÖN DENGE TEKERLEĞİ (Caster) -->
    <link name="caster_wheel">
        <visual>
            <geometry><sphere radius="0.03"/></geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry><sphere radius="0.03"/></geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="0.15 0 -0.05" rpy="0 0 0"/>
    </joint>

    <!-- 5. GAZEBO RENK VE FİZİK AYARLARI -->
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <!-- DİKKAT: Gazebo'da doğru yazım <mu1>değer</mu1>, value="" ÇALIŞMAZ -->
    <gazebo reference="caster_wheel">
        <material>Gazebo/White</material>
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <!-- 6. GAZEBO DİFERANSİYEL SÜRÜŞ EKLENTİSİ -->
    <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
            <update_rate>50</update_rate>
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <wheel_separation>0.34</wheel_separation>
            <wheel_diameter>0.12</wheel_diameter>

            <max_wheel_torque>5</max_wheel_torque>
            <!-- 10 rad/s^2 ≈ 0.6 m/s^2 doğrusal, ≈ 3.5 rad/s^2 açısal (Nav2 limitlerinden gevşek) -->
            <max_wheel_acceleration>10.0</max_wheel_acceleration>

            <odometry_source>1</odometry_source>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
        </plugin>
    </gazebo>

    <!-- LIDAR Sensör Modülünü Dahil Et -->
    <xacro:include filename="$(find my_robot_description)/urdf/lidar.xacro" />

</robot>