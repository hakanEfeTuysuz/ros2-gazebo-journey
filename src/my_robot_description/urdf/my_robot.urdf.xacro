<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="teknofest_agv">

    <!-- RViz2 Renkleri -->
    <material name="blue"><color rgba="0.1 0.2 0.8 1"/></material>
    <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
    <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>

    <!-- 1. ANA GÖVDE (Doğrudan base_link - TF karmaşasını sıfırlar) -->
    <link name="base_link">
        <visual>
            <geometry><box size="0.5 0.4 0.2"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry><box size="0.5 0.4 0.2"/></geometry>
        </collision>
        <inertial>
            <mass value="10.0"/>
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
    </link>
    <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>

    <!-- 2. SAĞ TEKERLEK -->
    <link name="sag_tekerlek">
        <visual>
            <geometry><cylinder radius="0.1" length="0.05"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><cylinder radius="0.1" length="0.05"/></geometry>
        </collision>
        <inertial>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>
    <gazebo reference="sag_tekerlek">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
    </gazebo>

    <joint name="sag_teker_mafsali" type="continuous">
        <parent link="base_link"/>
        <child link="sag_tekerlek"/>
        <origin xyz="0.15 -0.225 -0.1" rpy="1.5708 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <!-- 3. SOL TEKERLEK -->
    <link name="sol_tekerlek">
        <visual>
            <geometry><cylinder radius="0.1" length="0.05"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><cylinder radius="0.1" length="0.05"/></geometry>
        </collision>
        <inertial>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>
    <gazebo reference="sol_tekerlek">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
    </gazebo>

    <joint name="sol_teker_mafsali" type="continuous">
        <parent link="base_link"/>
        <child link="sol_tekerlek"/>
        <origin xyz="0.15 0.225 -0.1" rpy="1.5708 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <!-- 4. ÖN SARHOŞ (CASTER) TEKERLEK -->
    <link name="sarhos_tekerlek">
        <visual>
            <geometry><sphere radius="0.05"/></geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry><sphere radius="0.05"/></geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>
    <gazebo reference="sarhos_tekerlek">
        <material>Gazebo/White</material>
        <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
    <joint name="sarhos_mafsal" type="fixed">
        <parent link="base_link"/>
        <child link="sarhos_tekerlek"/>
        <origin xyz="-0.2 0 -0.15" rpy="0 0 0"/>
    </joint>

    <!-- 5. LIDAR SENSÖRÜ (Eski kararlı 0 - 6.28 tarama açısı) -->
    <link name="lidar_link">
        <visual>
            <geometry><cylinder radius="0.05" length="0.04"/></geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>
    <gazebo reference="lidar_link"><material>Gazebo/Red</material></gazebo>
    
    <joint name="lidar_mafsali" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
        <sensor name="rplidar_a2" type="ray">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>6.28</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros><remapping>~/out:=scan</remapping></ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- 6. DİFERANSİYEL SÜRÜŞ EKLENTİSİ (base_link referanslı stabil TF) -->
    <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
            <left_joint>sol_teker_mafsali</left_joint>
            <right_joint>sag_teker_mafsali</right_joint>
            <wheel_separation>0.45</wheel_separation>
            <wheel_diameter>0.2</wheel_diameter>
            <max_wheel_torque>20</max_wheel_torque>
            <max_wheel_acceleration>1.0</max_wheel_acceleration>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <command_topic>cmd_vel</command_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>
        </plugin>
    </gazebo>

</robot>