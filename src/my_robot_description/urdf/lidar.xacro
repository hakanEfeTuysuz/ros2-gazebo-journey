<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="red">
        <color rgba="0.8 0.1 0.1 1"/>
    </material>

    <!-- 1. LIDAR FİZİKSEL GÖVDESİ (Kırmızı Silindir) -->
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <!-- LIDAR'ı robotun ana gövdesinin (base_link) üst-ön kısmına sabitliyoruz -->
    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <!-- Şasi yüksekliği 0.1m idi (yarıçap 0.05m). 0.07m yukarı koyarak tam üstüne oturtuyoruz -->
        <origin xyz="0.1 0 0.07" rpy="0 0 0"/>
    </joint>

    <!-- 2. GAZEBO RAY (LIDAR) SENSÖR EKLENTİSİ -->
    <gazebo reference="laser_frame">
        <material>Gazebo/Red</material>

        <sensor name="laser" type="ray">
            <pose> 0 0 0 0 0 0 </pose>
            <!-- Gazebo'da mavi lazer ışınlarını gözle görmek için true yapıyoruz -->
            <visualize>true</visualize>
            <!-- Saniyede 10 kez tarama yap (10 Hz) -->
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <!-- 360 derecede (-pi ile +pi arası) 360 adet lazer ışını gönder -->
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <!-- 12 cm'den yakın (kendi gövdesi) ve 8 metreden uzak nesneleri yoksay -->
                    <min>0.12</min>
                    <max>8.0</max>
                </range>
            </ray>

            <!-- Veriyi ROS 2'deki /scan konusuna LaserScan mesajı olarak basan eklenti -->
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>
</robot>